<?xml version="1.0" encoding="utf-8"?>
<!-- Relative paths resolve against Invoke-BISF.ps1, not the current directory. -->
<BISF SchemaVersion="1">
  <Logging>
    <Enabled>true</Enabled>
    <Path>.\logs</Path>
  </Logging>
  <Cleanup>
    <WindowsTemp>true</WindowsTemp>
    <CurrentUserTemp>true</CurrentUserTemp>
    <!-- Enabled by default: delete unloaded non-system profiles from a quiescent MCS master. -->
    <UserProfiles>true</UserProfiles>
    <MinimumAgeDays>7</MinimumAgeDays>
    <!-- Clears only the invoking user's Recycle Bin when explicitly enabled. -->
    <RecycleBin>true</RecycleBin>
  </Cleanup>
  <!-- Enabled by default: clean superseded Windows update components through
       the inbox DISM PowerShell cmdlet; wait for completion before finalization. -->
  <Servicing>
    <ComponentCleanup>true</ComponentCleanup>
    <!-- Completion-time budget; active Windows servicing is never interrupted. -->
    <TimeoutMinutes>75</TimeoutMinutes>
  </Servicing>
  <!-- Enabled final seal cleanup: enabled Administrative/Operational event logs
       across eligible enabled channels. Security auditing and BISF execution logs are preserved. -->
  <LogCleanup>
    <WindowsEventLogs>true</WindowsEventLogs>
    <BISFLogs>false</BISFLogs>
  </LogCleanup>
  <ConfigurationManager>
    <PrepareIdentityReset>false</PrepareIdentityReset>
    <CloneTrustedRootKeyReset>false</CloneTrustedRootKeyReset>
  </ConfigurationManager>
  <!-- Requires an administrator-controlled local package and configuration. -->
  <Personalization>
    <Enabled>false</Enabled>
  </Personalization>
  <!-- Installed agents only. MCS owns machine identity and WEM owns cache refresh. -->
  <Citrix>
    <VDA>
      <Enabled>true</Enabled>
      <!-- Requires FinalAction=Shutdown. Startup type is never changed. -->
      <StopBeforeShutdown>false</StopBeforeShutdown>
    </VDA>
    <WEM>
      <Enabled>true</Enabled>
    </WEM>
  </Citrix>
  <Preflight>
    <BlockPendingReboot>true</BlockPendingReboot>
    <MinimumSystemDriveFreeGB>0</MinimumSystemDriveFreeGB>
    <BlockOtherLoadedProfiles>true</BlockOtherLoadedProfiles>
  </Preflight>
  <!-- Requires UserProfiles=true, FinalAction=Shutdown, administrator logoff,
       and a protected BIS-F local installation; enabled by default. -->
  <Finalization>
    <RemoveOperatorProfile>true</RemoveOperatorProfile>
    <TimeoutMinutes>30</TimeoutMinutes>
  </Finalization>
  <!-- None or Shutdown. Shutdown only follows successful Prepare. -->
  <Explorer>
    <RemoveQuickAccess>true</RemoveQuickAccess>
    <ClassicContextMenu>true</ClassicContextMenu>
  </Explorer>
  <FinalAction>Shutdown</FinalAction>
</BISF>
